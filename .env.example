# casa-nos — nomes das variaveis de ambiente.
#
# ESTE ARQUIVO NUNCA CARREGA VALOR. Nem exemplo plausivel, nem truncado, nem
# comentado. Copie para `.env.local` e preencha com os valores reais, que vivem
# so no painel da Vercel e no painel do Neon.

# ── Banco ────────────────────────────────────────────────────────────────────
# String de conexao do Neon Postgres (pooled). Usada pelo app, pelo runner de
# migration (`pnpm db:migrar`) e pelo seed (`pnpm db:seed`).
DATABASE_URL=

# ── Resolucao do evento ──────────────────────────────────────────────────────
# O evento e o inquilino. Em producao ele e resolvido pelo dominio da requisicao
# (tabela `evento_dominios`). Em localhost e no preview da Vercel o dominio nao
# bate com nenhum cadastro, entao vale este slug como padrao.
# Sem ele, `/` responde 404 fora do dominio de producao — o que e o
# comportamento correto, e nao um bug.
EVENTO_SLUG_PADRAO=

# ── Analytics ────────────────────────────────────────────────────────────────
# Id de medicao do GA4 (formato G-XXXXXXX). Vazio desliga o GA4 por completo:
# nenhum script carrega, nenhum evento e enfileirado.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Armazenamento (Cloudflare R2) ────────────────────────────────────────────
# O balde onde as fotos moram. Sem estas quatro, a rota de intencao responde 503
# e a linha de INTENCAO fica gravada no banco — que e o comportamento correto:
# o servidor sabe que a foto existe, e a reconciliacao (F1.6) vai procura-la.
#
# Endpoint S3 da conta, no formato https://<conta>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Nome do balde.
R2_BUCKET=
# Credencial S3 do balde. A chave de ACESSO nao e segredo; a de baixo e.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── E-mail transacional (Brevo) ──────────────────────────────────────────────
# Manda o link de acesso do casal (H-02) e o alerta ao dono (H-18). Vazias, nada
# e enviado e a tela continua funcionando — ela nao mente dizendo que mandou.
BREVO_API_KEY=
# Endereco remetente ja verificado na Brevo.
BREVO_REMETENTE=

# ── Observabilidade ──────────────────────────────────────────────────────────
# Para onde vai o alerta de taxa de erro (H-18). Vazio desliga o alerta; o
# registro em `eventos_de_erro` continua acontecendo de qualquer forma.
ALERTA_EMAIL=

# ── Interno ──────────────────────────────────────────────────────────────────
# Segredo do cabecalho que autentica o cron (F1.6). Vazio NAO libera a rota:
# sem ele a sessao de cron nunca e reconhecida, que e o lado seguro de errar.
CRON_SEGREDO=
